{
  "name": "@meddleware/status-ui",
  "private": true,
  "version": "0.1.31",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:html": "html-validate \"src/**/*.vue\"",
    "licenses": "mw-third-party-licenses",
    "check:licenses": "mw-third-party-licenses --check",
    "check:csp": "mw-check-csp-inline @Dockerfile dist",
    "shots": "SHOTS=1 playwright test",
    "test:e2e": "playwright test",
    "lhci": "npm run build && lhci autorun"
  },
  "dependencies": {
    "@meddleware/design-tokens": "^0.1.13",
    "@meddleware/ui": "^0.1.43",
    "@meddleware/web-utils": "^0.0.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.1",
    "@meddleware/frontend-config": "^0.0.8",
    "@playwright/test": "~1.64.1",
    "@types/node": "~26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "html-validate": "^11.18.0",
    "html-validate-vue": "^9.3.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "~5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.14"
  },
  "browserslist": [
    "extends @meddleware/frontend-config/browserslist-config"
  ],
  "overrides": {
    "basic-ftp": "^6.2.4",
    "tmp": "^0.2.7",
    "zod": "^4.6.7"
  },
  "meddleware": {
    "kind": "app",
    "csp": "static-strict",
    "lhci": true
  }
}
